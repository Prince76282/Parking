# DesignGym — Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local or any file containing real secrets.

# ─── Database ─────────────────────────────────────────────────────────────────
# Required for production persistence (PostgreSQL via Prisma).
# When DATABASE_URL is not set, the app uses localStorage as a fallback.
DATABASE_URL=postgresql://user:password@localhost:5432/designgym

# ─── AI Evaluation ────────────────────────────────────────────────────────────
# Optional. When set, the /api/evaluate route calls the OpenAI API.
# When not set, a labeled mock evaluation is returned so the app works offline.
# NEVER expose this key in client-side code.
OPENAI_API_KEY=sk-

# The OpenAI model to use for evaluation (default: gpt-4o-mini).
# Change to gpt-4o for higher quality feedback at higher cost.
AI_MODEL=gpt-4o-mini
